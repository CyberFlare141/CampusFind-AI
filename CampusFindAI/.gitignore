# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# .NET
**/bin/
**/obj/
**/.vs/
**/*.user
**/*.suo
**/TestResults/
**/appsettings.Local.json

# Runtime report uploads (paths are stored in SQL Server; image files are local/runtime data)
backend/wwwroot/uploads/

# Node / Vite
**/node_modules/
**/dist/
**/.vite/
**/.env
**/.env.*
!**/.env.example
**/*.local
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# User-submitted report files live in the configured storage directory, not source control.
backend/wwwroot/uploads/reports/*
!backend/wwwroot/uploads/reports/.gitkeep

# EF migrations are intentionally generated/committed later by the team.
# Keep the directory placeholder but ignore generated migration files.
backend/Data/Migrations/*
!backend/Data/Migrations/.gitkeep
